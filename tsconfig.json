{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@components/*": ["./src/components/*"],
			"@screens/*": ["./src/screens/*"],
			"@constants/*": ["./src/constants/*"],
			"@entities/*": ["./src/entities/*"],
			"@navigation/*": ["./src/navigation/*"],
			"@store/*": ["./src/store/*"],
			"@services/*": ["./src/services/*"],
			"@hooks/*": ["./src/hooks/*"]
		}
	}
}
